<?xml version="1.0" encoding="utf-8"?>
<!--
  STAR7 CAD MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the WixUI extension:
  `wix extension add -g WixToolset.UI.wixext/5.0.2`). Built by package.ps1:

    wix build cadcraft.wxs -arch x64 -ext WixToolset.UI.wixext -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, an optional desktop shortcut, and
  STAR7 CAD offered under "Open with" for .dxf and .dwg drawings (without taking over the user's
  default app).

  Desktop shortcut: the setup wizard asks (unchecked by default). Silent installs leave it out
  unless asked: `msiexec /i cadcraft.msi /qn DESKTOPSHORTCUT=1`. Upgrades keep the previous choice
  unless DESKTOPSHORTCUT=1 or DESKTOPSHORTCUT=0 is given.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif ?>
  <Package
      Name="STAR7 CAD"
      Manufacturer="STAR7"
      Version="$(var.Version)"
      UpgradeCode="119D7D76-0167-4A9E-8F37-09DA0235F68E"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="STAR7 CAD - Computação Gráfica e Engenharia" Manufacturer="STAR7" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of STAR7 CAD is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="CadcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="CadcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://suite.star-7.app.br" />
    <Property Id="ARPURLUPDATEINFO" Value="https://suite.star-7.app.br" />
    <Property Id="ARPHELPLINK" Value="https://star-7.app.br" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="STAR7 CAD" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <!-- Per-machine (ALLUSERS=1), so this is the all-users (Public) desktop, like the Start Menu above. -->
    <StandardDirectory Id="DesktopFolder" />

    <!-- "Create a desktop shortcut": the wizard's checkbox sets it to 1 (cleared = unset), and
         silent installs pass DESKTOPSHORTCUT=1. Secure, so the elevated install sees the UI choice. -->
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />

    <!-- On upgrade, read the previous desktop shortcut choice out of HKCU if DESKTOPSHORTCUT
         was not passed explicitly on the command line. -->
    <SetProperty Id="DESKTOPSHORTCUT" Value="[PreviousDesktopShortcut]"
        Before="CostFinalize" Sequence="both"
        Condition="NOT DESKTOPSHORTCUT AND PreviousDesktopShortcut" />
    <Property Id="PreviousDesktopShortcut">
      <RegistrySearch Id="PreviousDesktopShortcut" Root="HKCU" Key="Software\STAR7\STAR7 CAD"
          Name="DesktopShortcut" Type="raw" />
    </Property>

    <!-- WiX UI extension: WixUI_InstallDir dialog set (welcome, license, destination directory,
         verify-ready, progress, exit). Adds our custom "create desktop shortcut" checkbox to the
         InstallDirDlg (see below). -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="CadcraftUI" />

    <Feature Id="Main" Title="STAR7 CAD" Level="1">
      <ComponentGroupRef Id="CadcraftFiles" />
      <ComponentRef Id="CadcraftDesktopShortcut" />
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentRef Id="CraftFontLicences" />
      <?endif ?>
    </Feature>

    <!-- Per-machine install components live in CadcraftFiles: the .exe itself, Start Menu shortcut,
         open-with associations, and CLI binary. -->
    <ComponentGroup Id="CadcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="CadcraftApp" Guid="2AC18056-48DE-4079-AB79-4FDEF4FBB075">
        <File Id="CadcraftExe" Source="$(var.BinDir)\cadcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="STAR7 CAD"
              Description="STAR7 CAD - Computação Gráfica e Engenharia" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="CadcraftIcon.ico" IconIndex="0" />
        </File>

        <!-- App Paths lets `cadcraft` work in the Win+R Run dialog without dirtying %PATH%. -->
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\cadcraft.exe" Value="[#CadcraftExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\cadcraft.exe\shell\open\command" Value="&quot;[#CadcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dxf\OpenWithProgids" Name="STAR7.CAD.Drawing" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dwg\OpenWithProgids" Name="STAR7.CAD.Drawing" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\STAR7.CAD.Drawing\shell\open\command" Value="&quot;[#CadcraftExe]&quot; &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="CadcraftCli">
        <File Id="CadcraftCliExe" Source="$(var.BinDir)\cadcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Desktop shortcut is conditional on the DESKTOPSHORTCUT property. Desktop shortcuts cannot
         be advertised, so the component's KeyPath is a HKCU registry value; per-machine installs
         writing to HKCU run during the user-context phase of execution. -->
    <Component Id="CadcraftDesktopShortcut" Directory="DesktopFolder"
        Guid="575E7B78-FA6F-4228-B4C2-A6F72739DB6B" Condition="DESKTOPSHORTCUT = 1">
      <Shortcut Id="DesktopShortcut" Name="STAR7 CAD" Description="STAR7 CAD - Computação Gráfica e Engenharia"
          Target="[INSTALLFOLDER]cadcraft.exe" WorkingDirectory="INSTALLFOLDER" Icon="CadcraftIcon.ico" IconIndex="0" />
      <RegistryValue Root="HKCU" Key="Software\STAR7\STAR7 CAD" Name="DesktopShortcut"
          Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <?if $(var.HasCraftFontLicences) = 1 ?>
    <Component Id="CraftFontLicences" Directory="INSTALLFOLDER" Guid="6A41B66D-FA63-44CD-BE9D-626F92B30291">
      <File Id="CraftFontLicencesFile" Source="$(var.BinDir)\craft-font-licences.txt" KeyPath="yes" />
    </Component>
    <?endif ?>

    <!-- Custom WixUI dialog sequence: inject a "Create desktop shortcut" checkbox into the
         standard WixUI_InstallDir flow, on the directory-selection dialog. -->
    <UI Id="CadcraftUI">
      <Property Id="WixUI_Mode" Value="InstallDir" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <!-- Custom InstallDirDlg adds the checkbox above the Back/Next buttons. -->
      <Dialog Id="InstallDirDlgWithShortcut" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.InstallDirDlgDescription)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.InstallDirDlgTitle)" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="FolderLabel" Type="Text" X="20" Y="60" Width="290" Height="30" NoPrefix="yes" Text="!(loc.InstallDirDlgFolderLabel)" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="100" Width="320" Height="18" Property="WIXUI_INSTALLDIR" Indirect="yes" />
        <Control Id="ChangeFolder" Type="PushButton" X="20" Y="120" Width="56" Height="17" Text="!(loc.InstallDirDlgChange)" />

        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="160" Width="290" Height="17"
            Property="DESKTOPSHORTCUT" CheckBoxValue="1"
            Text="Criar atalho na Área de Trabalho" />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="InstallDirDlgWithShortcut" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="InstallDirDlgWithShortcut" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlgWithShortcut" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />
      <Publish Dialog="InstallDirDlgWithShortcut" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlgWithShortcut" Control="Next" Event="DoAction" Value="WixUIValidatePath" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="InstallDirDlgWithShortcut" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="3" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlgWithShortcut" Condition="LicenseAccepted = &quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlgWithShortcut" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>
  </Package>
</Wix>
